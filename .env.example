# Ghost-VPA Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Persistence Configuration
# Standalone high-performance async SQLite with WAL mode for prototype
DATABASE_URL=sqlite+aiosqlite:///./data/ghost_vpa.db

# In-Memory Simulation Rail Settings
SIMULATOR_SEED=42
SIMULATOR_DEFAULT_SPEED=1
SIMULATOR_TICK_INTERVAL_SEC=1.0

# Temporal Graph Engine Settings
GRAPH_TEMPORAL_WINDOW_HOURS=72
GRAPH_CSLP_DECAY_LAMBDA=0.05
GRAPH_CSLP_RESTART_ALPHA=0.85
GRAPH_MAX_EGO_NODES=50
GRAPH_MAX_EGO_EDGES=100

# Security and RBAC
DEFAULT_USER_ROLE=Analyst
MOCK_RBAC_ENABLED=true
STIX_SYNTHETIC_MARKING=true
